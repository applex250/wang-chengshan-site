<!doctype html>
{%- comment -%}
  本站覆盖(2026-08):基于 al_folio_core gem 同名文件,仅两处改动——
  1) 内容容器加 id="swup" + class="swup-transition-main",作为 swup 页面切换的
     唯一替换容器(导航栏 header、页脚 footer 在容器外,切换时保持不动);
  2) 容器内尾部 include scripts_page.liquid(页面级脚本),
     由 SwupScriptsPlugin 在每次交换后重放。
{%- endcomment -%}
{%- capture html_attributes -%}
  {%- if site.plugins contains 'al_rtl' -%}
    {%- include plugins/al_rtl_html_attrs.liquid -%}
  {%- else -%}
    lang="{{ site.lang }}"
  {%- endif -%}
{%- endcapture -%}
<html {{ html_attributes }}>
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% if page.hero %}home-hero-page{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content(swup 唯一替换容器) -->
    <div class="container mt-5 swup-transition-main" role="main" id="swup">
      {% if page.toc and page.toc.sidebar %}
        {% assign toc_collapse = page.toc.collapse | default: 'expanded' %}
        {% assign toc_collapse_depth = page.toc.collapse_depth | default: '' %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav
                id="toc-sidebar"
                class="sticky-top toc toc-sidebar"
                aria-label="Table of contents"
                data-toc-collapse="{{ toc_collapse }}"
                data-toc-collapse-depth="{{ toc_collapse_depth }}"
              ></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}

      <!-- 页面级脚本(随容器一起被 swup 替换,由 ScriptsPlugin 重放) -->
      {% include scripts_page.liquid %}
    </div>

    <!-- JavaScripts(全局,仅初始加载执行一次) -->
    {% include scripts.liquid %}
  </body>
</html>

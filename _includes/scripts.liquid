<script data-swup-ignore-script>
  window.alFolio = {
    compatBootstrap: {{ site.al_folio.compat.bootstrap.enabled | default: false | jsonify }}
  };
</script>

<!-- Core navigation/runtime scripts (data-swup-ignore-script: 持久区脚本,
     只执行一次,swup 切换时不重放——否则 SwupScriptsPlugin 会全文档重放,
     导致 nav-toggle 重复绑定、swup-init 二次实例化白屏) -->
<script data-swup-ignore-script src="{{ '/assets/js/nav-toggle.js' | relative_url | bust_file_cache }}"></script>
{% if site.al_folio.compat.bootstrap.enabled %}
  <script data-swup-ignore-script src="{{ '/assets/js/bootstrap-compat.js' | relative_url | bust_file_cache }}"></script>
{% endif %}

<!-- ============ 库文件(仅定义全局对象,全局加载一次) ============
     2026-08 swup 接入:库与初始化分离。库常驻全局,容器内初始化脚本
     重放时总能找到 window.Masonry / window.tocbot / window.AlFolioUi,
     消除动态插入脚本的执行顺序竞态。不用 defer:需在解析阶段先于
     容器内 defer 初始化脚本执行(位于 body 末尾,阻塞可忽略)。 -->
{% if site.enable_masonry %}
  <!-- Masonry & imagesLoaded libraries -->
  <script
    data-swup-ignore-script
    src="{{ site.third_party_libraries.masonry.url.js }}"
    integrity="{{ site.third_party_libraries.masonry.integrity.js }}"
    crossorigin="anonymous"
  ></script>
  <script
    data-swup-ignore-script
    src="{{ site.third_party_libraries.imagesloaded.url.js }}"
    integrity="{{ site.third_party_libraries.imagesloaded.integrity.js }}"
    crossorigin="anonymous"
  ></script>
{% endif %}

<!-- Tocbot library(初始化在内容区的 common.js 中) -->
<script
  data-swup-ignore-script
  src="{{ site.third_party_libraries.tocbot.url.js }}"
  integrity="{{ site.third_party_libraries.tocbot.integrity.js }}"
  crossorigin="anonymous"
></script>

<!-- Tooltips & popovers runtime(定义 window.AlFolioUi;内容区 tooltip
     由 swup-init.js 的 content:replace 钩子在新内容上重新初始化) -->
<script data-swup-ignore-script src="{{ '/assets/js/tooltips-setup.js' | relative_url | bust_file_cache }}"></script>

<!-- Load Common JS(no_defer 防主题闪烁,全局一次) -->
<script data-swup-ignore-script src="{{ '/assets/js/no_defer.js' | relative_url | bust_file_cache }}"></script>

{% if site.enable_cookie_consent and site.plugins contains 'al_cookie' %}
  <!-- Cookie Consent -->
  {% include plugins/al_cookie_scripts.liquid %}
{% endif %}
{% if site.plugins contains 'al_analytics' %}
  <!-- Analytics -->
  {% include plugins/al_analytics_scripts.liquid %}
{% endif %}

{% if site.enable_progressbar %}
  <!-- Scrolling Progress Bar -->
  <script defer data-swup-ignore-script src="{{ '/assets/js/progress-bar.js' | relative_url | bust_file_cache }}" type="text/javascript"></script>
{% endif %}

{% if site.back_to_top %}
  <!-- Back to Top -->
  {% assign back_to_top_js = site.third_party_libraries['vanilla-back-to-top'].url.js
    | default: 'https://cdn.jsdelivr.net/npm/vanilla-back-to-top@7.2.1/dist/vanilla-back-to-top.min.js'
  %}
  {% assign back_to_top_integrity = site.third_party_libraries['vanilla-back-to-top'].integrity.js %}
  {% if back_to_top_integrity %}
    <script data-swup-ignore-script src="{{ back_to_top_js }}" integrity="{{ back_to_top_integrity }}" crossorigin="anonymous"></script>
  {% else %}
    <script data-swup-ignore-script src="{{ back_to_top_js }}"></script>
  {% endif %}
  <script data-swup-ignore-script>
    addBackToTop();
  </script>
{% endif %}

{% if site.search_enabled %}
  <!-- Search -->
  {% if site.plugins contains 'al_search' %}
    {% include plugins/al_search_assets.liquid %}
  {% endif %}
{% endif %}

{% if site.newsletter.enabled %}
  {% if site.plugins contains 'al_newsletter' %}
    {% include plugins/al_newsletter_scripts.liquid %}
  {% endif %}
{% endif %}

{% if site.protect_email and site.plugins contains 'al_email_protect' %}
  <!-- Email obfuscation -->
  {% include plugins/al_email_protect_scripts.liquid %}
{% endif %}

{% if page.marimo and site.plugins contains 'al_marimo' %}
  <!-- Marimo notebooks -->
  {% include plugins/al_marimo_scripts.liquid %}
{% endif %}

<!-- Swup 页面切换(2026-08):库本体本地化于 assets/js/vendor/swup/,
     初始化见 assets/js/swup-init.js。库加载失败时 swup-init 静默返回,
     整站回退为普通整页跳转。以下四者均为持久区脚本,加 data-swup-ignore-script
     防止被 ScriptsPlugin 全文档重放(重放会让 swup-init 二次实例化→双实例
     竞争 is-animating 类→内容区永久 opacity:0 白屏)。 -->
<script data-swup-ignore-script src="{{ '/assets/js/vendor/swup/Swup.umd.js' | relative_url }}"></script>
<script data-swup-ignore-script src="{{ '/assets/js/vendor/swup/SwupHeadPlugin.umd.js' | relative_url }}"></script>
<script data-swup-ignore-script src="{{ '/assets/js/vendor/swup/SwupScriptsPlugin.umd.js' | relative_url }}"></script>
<script data-swup-ignore-script src="{{ '/assets/js/swup-init.js' | relative_url | bust_file_cache }}"></script>

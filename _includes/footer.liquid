{% comment %}
  2026-08:版权栏文字已按要求清空(版权所有/课题组成员/Powered by 等)。
  保留 footer 空结构以维持 sticky-bottom 布局,后续如需版权信息在此填写。
{% endcomment %}
{% assign footer_contents = "" %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid %}
      {% endif %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}

{% raw %}
<script>
// 搜索面板（ninja-keys）运行时汉化：占位符 + 分区标题。数据由 al_search 在客户端异步注入，故轮询兼容。
(function () {
  var SECTION_MAP = {
    Navigation: "导航",
    Posts: "随笔",
    Dropdown: "更多",
    Socials: "社交",
    Theme: "主题",
    News: "新闻",
    Projects: "项目",
    Teachings: "教学",
    Books: "书架",
    Repositories: "仓库",
    Profiles: "成员",
  };
  function localizeNinja() {
    var nk = document.querySelector("ninja-keys");
    if (!nk) return false;
    try {
      nk.placeholder = "输入命令或搜索…";
      nk.hotKeysJoinedTip = nk.hotKeysJoinedTip; // no-op, keep
    } catch (e) {}
    if (nk.data && nk.data.length) {
      var changed = false;
      var TITLE_MAP = {
        "Change theme to light": "切换到浅色主题",
        "Change theme to dark": "切换到深色主题",
        "Use system default theme": "使用系统默认主题",
        "Change the theme of the site to Light": "将站点主题切换为浅色",
        "Change the theme of the site to Dark": "将站点主题切换为深色",
        "Change the theme of the site to System Default": "将站点主题切换为系统默认",
      };
      var next = nk.data.map(function (it) {
        var zhSec = SECTION_MAP[it.section];
        var zhTitle = TITLE_MAP[it.title];
        var zhDesc = TITLE_MAP[it.description];
        if (zhSec || zhTitle || zhDesc) {
          changed = true;
          var o = Object.assign({}, it);
          if (zhSec) o.section = zhSec;
          if (zhTitle) o.title = zhTitle;
          if (zhDesc) o.description = zhDesc;
          return o;
        }
        return it;
      });
      if (changed) {
        nk.data = next;
      }
    }
    return true;
  }
  var tries = 0;
  var timer = setInterval(function () {
    tries++;
    localizeNinja();
    if (tries > 30) {
      clearInterval(timer);
    }
  }, 200);
  // 通过快捷键（Ctrl/Cmd+K）打开时再补一次
  document.addEventListener("keydown", function (e) {
    if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
      setTimeout(localizeNinja, 60);
    }
  });
})();
</script>
{% endraw %}

<!-- instant.page: 悬停/触摸时预取目标页，使站内导航接近秒开（自托管，无外部依赖） -->
<script type="module" src="{{ '/assets/js/instantpage.js' | relative_url | bust_file_cache }}"></script>

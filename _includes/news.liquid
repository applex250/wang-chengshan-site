<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | reverse %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div class="news-archive">
      {% assign current_year = '' %}
      {% for item in news limit: news_limit %}
        {% assign item_year = item.date | date: '%Y' %}
        {% if item_year != current_year %}
          {% unless current_year == '' %}
              </ol>
            </section>
          {% endunless %}
          {% assign current_year = item_year %}
          <section class="news-year" aria-labelledby="news-year-{{ item_year }}">
            <h2 id="news-year-{{ item_year }}">{{ item_year }}</h2>
            <ol class="news-year-list">
        {% endif %}
        <li class="news-entry">
          <time datetime="{{ item.date | date_to_xmlschema }}">{{ item.date | date: '%m.%d' }}</time>
          <div class="news-entry-content">
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% elsif item.external_url %}
              <a class="news-title" href="{{ item.external_url }}" target="_blank" rel="noopener noreferrer">{{ item.title }}</a>
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
      {% unless current_year == '' %}
          </ol>
        </section>
      {% endunless %}
    </div>
  {% else %}
    <p>{% t news.empty %}</p>
  {% endif %}
</div>
